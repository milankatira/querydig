{
  "name": "querydig",
  "version": "0.8.0",
  "mcpName": "io.github.milankatira/querydig",
  "description": "Find slow, N+1 and unoptimized database queries (MongoDB, Postgres, MySQL) in JS/TS, Python, Go, Java, Ruby and PHP code, with optional read-only live evidence from your database. Zero-config CLI for local runs and CI.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js',0o755)\"",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mongodb",
    "mongoose",
    "sql",
    "postgres",
    "mysql",
    "prisma",
    "spring-data",
    "hibernate",
    "activerecord",
    "rails",
    "laravel",
    "eloquent",
    "doctrine",
    "n+1",
    "slow-query",
    "query-optimization",
    "performance",
    "static-analysis",
    "cli",
    "npx",
    "ci",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "github-action",
    "n-plus-one",
    "orm",
    "database",
    "linter",
    "typeorm",
    "sequelize",
    "django",
    "sqlalchemy",
    "gorm",
    "mongodb-performance",
    "sarif",
    "eslint",
    "eslint-plugin",
    "eslintplugin"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^15.1.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.14",
    "picocolors": "^1.1.1",
    "web-tree-sitter": "0.22.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "tree-sitter-wasms": "^0.1.13",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  },
  "bin": {
    "querydig": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint.d.ts",
      "import": "./dist/eslint.js"
    }
  },
  "files": [
    "dist",
    "grammars",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milankatira/querydig.git"
  },
  "homepage": "https://milankatira.github.io/querydig/",
  "bugs": {
    "url": "https://github.com/milankatira/querydig/issues"
  },
  "optionalDependencies": {
    "mongodb": "^7.8.0",
    "pg": "^8.23.1"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
